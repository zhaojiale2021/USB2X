{
    "version": 3,
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Debug build with -g -Wall -Wextra",
            "generator": "Ninja",
            "binaryDir": "build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "toolchains/stm32_toolchain.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "VARIANT": "CANABLE"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "description": "Release build with -O2 -Wall -Wextra",
            "generator": "Ninja",
            "binaryDir": "build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "toolchains/stm32_toolchain.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "VARIANT": "CANABLE"
            }
        },
        {
            "name": "minsize",
            "displayName": "MinSizeRel",
            "description": "Minimal size build with -Os -Wall -Wextra",
            "generator": "Ninja",
            "binaryDir": "build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel",
                "CMAKE_TOOLCHAIN_FILE": "toolchains/stm32_toolchain.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "VARIANT": "CANABLE"
            }
        },
        {
            "name": "reldebug",
            "displayName": "RelWithDebInfo",
            "description": "Release with debug info -O2 -g -Wall -Wextra",
            "generator": "Ninja",
            "binaryDir": "build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_TOOLCHAIN_FILE": "toolchains/stm32_toolchain.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "VARIANT": "CANABLE"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "minsize",
            "configurePreset": "minsize"
        },
        {
            "name": "reldebug",
            "configurePreset": "reldebug"
        }
    ]
}